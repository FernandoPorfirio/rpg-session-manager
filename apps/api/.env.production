# Exemplo das variáveis que você precisará configurar no Vercel Dashboard

# NODE_ENV=production
# PORT=3000 (o Vercel define automaticamente)

# Database - Configure com seu provider (Railway, Neon, Supabase, etc.)
# DB_HOST=your-production-db-host
# DB_USER=your-production-db-user
# DB_PASSWORD=your-production-db-password
# DB_NAME=your-production-db-name
# DB_PORT=5432

# JWT Secret - Use um valor mais seguro em produção
# JWT_SECRET=your-super-secure-jwt-secret-for-production
